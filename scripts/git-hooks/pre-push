#!/usr/bin/env bash
# pre-push: same static gate as CI rust job
#   cargo clippy --all-targets -- -D warnings
#
# Skip (emergency / docs-only when you know CI will run):
#   AX_SKIP_CLIPPY=1 git push
#   git push --no-verify

set -euo pipefail

if [[ "${AX_SKIP_CLIPPY:-}" == "1" ]]; then
  echo "pre-push: AX_SKIP_CLIPPY=1 — skipping clippy" >&2
  exit 0
fi

# Only run for pushes that include this repo's Rust crate.
root="$(git rev-parse --show-toplevel 2>/dev/null || true)"
if [[ -z "$root" || ! -f "$root/Cargo.toml" ]]; then
  exit 0
fi

cd "$root"

if ! command -v cargo >/dev/null 2>&1; then
  echo "pre-push: cargo not found; install Rust or set AX_SKIP_CLIPPY=1" >&2
  exit 1
fi

echo "pre-push: cargo clippy --all-targets -- -D warnings" >&2
cargo clippy --all-targets -- -D warnings

echo "pre-push: clippy ok" >&2
exit 0
